# Local Docker Compose settings. Replace the placeholder secrets before starting.
# Keep DB_PASSWORD URL-safe (letters, numbers, hyphens, and underscores).
DB_USER=postgres
DB_PASSWORD=change-this-local-only
DB_NAME=url_shortener

# Required by the application. Use a long, random value.
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_API_SECRET=replace-with-another-random-secret

# The public URL users will visit. This is also used during the Next.js build.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional integrations
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
RESEND_API_KEY=